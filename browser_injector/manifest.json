{
  "manifest_version": 3,
  "name": "Antibot CV Local Injector",
  "version": "0.3.30",
  "description": "Local command bridge for the Troecarstvie automation controller.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "Antibot CV",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://3kingdoms.ru/*",
    "http://127.0.0.1:17654/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://3kingdoms.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page_bridge.js"
      ],
      "matches": [
        "https://3kingdoms.ru/*"
      ]
    }
  ]
}
